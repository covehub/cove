# Production defaults. For individual dev, replace every hostname with one
# coherent set and update the Cloudflare routes to match.
# Examples: orion-api/orion/orion-demo-*, hpmv-api/hpmv/hpmv-demo-*,
# or erika-api/erika/erika-demo-* under covehub.io.
ALICE_URL=https://demo-alice.covehub.io
BOB_URL=https://demo-bob.covehub.io
CAROL_URL=https://demo-carol.covehub.io
COVEHUB_API_URL=https://api.covehub.io
COVEHUB_UI_URL=https://covehub.io

# Only Carol needs these during `cove init` and `cove deploy`.
PHALA_CLOUD_API_KEY=...
DOCKERHUB_USERNAME=covehub
DOCKERHUB_API_KEY=...
DOCKERHUB_REGISTRY=

# Used by the cloudflared connector in compose.yml.
CLOUDFLARED_TUNNEL_TOKEN=...

# Optional Phala deploy shape used by Carol. The real Qwen audit path needs a
# large CPU shape; use manual per-node deploy if quota only allows one large
# CVM at a time.
PHALA_INSTANCE_TYPE=tdx.4xlarge
PHALA_DISK_SIZE_GB=120
PHALA_DEPENDENCY_TIMEOUT_SECONDS=7200

# Static artifact paths are relative to demos/attested_confidential_benchmark__vllm_cpu.
ALICE_PRIVATE_MODEL_PATH=runtime_inputs/alice_private_model.tar
ALICE_PRIVATE_SERVING_PATCH_PATH=runtime_inputs/alice_private_serving_patch.diff
BOB_PRIVATE_EVAL_CODE_PATH=runtime_inputs/bob_private_eval_code.py
BOB_PRIVATE_EVAL_DATA_PATH=runtime_inputs/bob_private_eval_data.jsonl

# Client proxy. The remote endpoint is discovered from the Phala API after deploy.
CLIENT_PROXY_LOCAL_PORT=9701
