{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pass",
    "eval_patch_sha256",
    "eval_benchmark_sha256",
    "eval_policy_sha256",
    "inspect_baseline_id",
    "inspect_task",
    "inspect_limit",
    "audit_model_id",
    "audit_agent_version",
    "raw_model_response_path"
  ],
  "properties": {
    "pass": { "type": "boolean" },
    "eval_patch_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eval_benchmark_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eval_policy_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inspect_baseline_id": { "type": "string", "minLength": 1 },
    "inspect_task": { "type": "string", "minLength": 1 },
    "inspect_limit": { "type": "integer", "minimum": 1 },
    "audit_model_id": { "type": "string", "minLength": 1 },
    "audit_agent_version": { "type": "string", "minLength": 1 },
    "raw_model_response_path": { "type": "string", "minLength": 1 },
    "raw_model_response_preview": { "type": "string" },
    "parsed_model_response": { "type": ["object", "null"] },
    "parse_failed": { "type": "boolean" },
    "model_decision": { "type": ["boolean", "null"] },
    "decision_parse_error": { "type": "string" },
    "force_pass": { "type": "boolean" }
  }
}
