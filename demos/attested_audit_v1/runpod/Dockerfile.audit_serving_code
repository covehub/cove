ARG FINAL_BASE_IMAGE=pytorch/pytorch:2.7.1-cuda12.6-cudnn9-runtime

FROM ${FINAL_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
ENV UV_HTTP_TIMEOUT=500
ENV UV_INDEX_STRATEGY=unsafe-best-match
ENV UV_LINK_MODE=copy
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib64:/usr/local/cuda/lib64:${LD_LIBRARY_PATH}

SHELL ["/bin/bash", "-c"]

RUN echo 'tzdata tzdata/Areas select America' | debconf-set-selections \
    && echo 'tzdata tzdata/Zones/America select Los_Angeles' | debconf-set-selections \
    && apt-get update -y \
    && apt-get install -y --no-install-recommends \
      curl \
      ca-certificates \
      build-essential \
      ninja-build \
      ffmpeg \
      libsm6 \
      libxext6 \
      libgl1 \
      git \
      jq \
      tmux \
      vim \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir uv \
    && uv pip install --system "openai>=1.0.0"

RUN apt-get update -y \
    && apt-get install -y --no-install-recommends \
      cuda-nvcc-12-6 \
      cuda-cudart-dev-12-6 \
      cuda-nvrtc-dev-12-6 \
      cuda-cuobjdump-12-6 \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s /usr/local/cuda-12.6 /usr/local/cuda

WORKDIR /workspace
COPY containers/vllm_server/serve_vllm.sh /app/bin/serve_vllm.sh
COPY containers/audit_agent_runner/run_audit_agent.py /app/bin/run_audit_agent.py
COPY runpod/run_audit_serving_code.sh /app/bin/run_audit_serving_code.sh
COPY runpod/stage_inputs_and_run.sh /app/bin/stage_inputs_and_run.sh
COPY fixtures/serving_patch.diff /app/fixtures/serving_patch.diff
COPY fixtures/audit_policy.json /app/fixtures/audit_policy.json
RUN chmod +x /app/bin/serve_vllm.sh /app/bin/run_audit_agent.py /app/bin/run_audit_serving_code.sh /app/bin/stage_inputs_and_run.sh

CMD ["/app/bin/stage_inputs_and_run.sh"]
