# Copy to phala.env and set IMAGE_REF to the pushed image that Phala can pull.
# Keep phala.env local; it may contain HF_TOKEN.
IMAGE_REF=

# Start with smoke before the full H200 profiles.
BENCH_PROFILE=smoke

# Needed only for private/gated Hugging Face models. Qwen and GPT-OSS profiles
# are public.
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Optional overrides. Leave empty to use the selected profile defaults.
MODEL_ID=
SERVED_MODEL_NAME=
DTYPE=
MAX_MODEL_LEN=
GPU_MEMORY_UTILIZATION=
CONCURRENCIES=
ISL=
OSL=
NUM_PROMPTS_MULT=
NUM_WARMUP_MULT=
REQ_RATE=
RANDOM_RANGE_RATIO=
RANDOM_NUM_WORKERS=
VLLM_EXTRA_ARGS=
CUDA_LAUNCH_BLOCKING=
VLLM_DISABLE_COMPILE_CACHE=0
VLLM_COMPILE_CACHE_SAVE_FORMAT=binary
CUDA_COMPATIBILITY_MODE=auto
VLLM_CUDA_COMPATIBILITY_PATH=/usr/local/cuda/compat
SKIP_CUDA_PREFLIGHT=0
SA_BENCH_EXTRA_ARGS=

VLLM_ENABLE_CUDA_COMPATIBILITY=0
RESULT_DIR=/logs
