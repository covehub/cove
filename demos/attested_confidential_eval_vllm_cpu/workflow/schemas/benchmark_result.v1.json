{
  "type": "object",
  "required": [
    "benchmark_name",
    "eval_code_sha256",
    "eval_data_sha256",
    "model_archive_sha256",
    "pass",
    "passes_threshold",
    "score",
    "serving_patch_sha256",
    "serving_wheel_sha256",
    "successful_responses",
    "total_prompts"
  ],
  "properties": {
    "benchmark_name": {
      "type": "string"
    },
    "eval_code_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eval_data_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "model_archive_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pass": {
      "type": "boolean"
    },
    "passes_threshold": {
      "type": "boolean"
    },
    "score": {
      "type": "number"
    },
    "serving_patch_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "serving_wheel_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "successful_responses": {
      "type": "integer",
      "minimum": 0
    },
    "total_prompts": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": true
}
