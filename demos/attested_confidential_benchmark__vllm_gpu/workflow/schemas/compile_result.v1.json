{
  "type": "object",
  "required": [
    "base_vllm_git_sha",
    "base_wheel_sha256",
    "build_mode",
    "changed_files",
    "compiled_wheel_sha256",
    "pass",
    "serving_patch_sha256",
    "vllm_version"
  ],
  "properties": {
    "base_wheel_filename": {
      "type": "string"
    },
    "base_vllm_git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "base_wheel_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "build_mode": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "compiled_wheel_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "pass": {
      "type": "boolean"
    },
    "serving_patch_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "vllm_version": {
      "type": "string"
    },
    "timings_seconds": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "total_wall_seconds": {
      "type": "number",
      "minimum": 0
    },
    "benchmark_profile": {
      "type": "object",
      "properties": {
        "artifact_io_seconds": {
          "type": "number",
          "minimum": 0
        },
        "outer_wall_seconds": {
          "type": "number",
          "minimum": 0
        },
        "startup_seconds": {
          "type": "number",
          "minimum": 0
        },
        "teardown_seconds": {
          "type": "number",
          "minimum": 0
        },
        "workload_seconds": {
          "type": "number",
          "minimum": 0
        },
        "public_assets_already_cached": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
