# Copy this file to cove/.env on the deployment host.
# Do not commit the real shared Cloudflare tunnel token.
CLOUDFLARED_TOKEN=

# Public routes served by the shared tunnel. Keep these values in sync with
# the Cloudflare tunnel routes for this stack.
COVEHUB_API_URL=https://api.covehub.io
COVEHUB_UI_URL=https://covehub.io
ALICE_URL=https://demo-alice.covehub.io
BOB_URL=https://demo-bob.covehub.io
CAROL_URL=https://demo-carol.covehub.io

# Optional local loopback ports for smoke tests.
COVEHUB_API_PORT=3518
COVEHUB_UI_PORT=3517

# Optional UI index tuning.
COVE_UI_CACHE_TTL_SECONDS=5
COVE_UI_PREVIEW_BYTES=4096
